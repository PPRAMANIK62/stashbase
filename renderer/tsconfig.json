{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/protocols/*": ["../shared/protocols/*"],
      "@/shared/file-formats": ["../shared/file-formats.ts"],
      "@/shared/html-sanitization": ["../shared/html-sanitization.ts"],
      "@/shared/agent-runtime": ["../shared/agent-runtime.ts"],
      "@/shared/agent-protocol": ["../shared/agent-protocol.ts"],
      "@/shared/account": ["../shared/account.ts"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", ".storybook", "vite.config.ts"]
}
